mixin mainMenu
	a.header__menu-item.anchor.active(href='#anchor-1')
		span Альтернатива <br> Oracle Exadata
	a.header__menu-item.anchor(href='#anchor-2') Что делать, когда <br> PostgreSQL уже не хватает?
	a.header__menu-item.anchor(href='#anchor-3') Как ИИ меняет <br> эксплуатацию СУБД?
	a.header__menu-item.anchor(href='#anchor-4') Экосистема <br> Tantor
	a.header__menu-item.anchor(href='#anchor-5') 5 лет <br> «Тантор Лабс»

header.header
	.container.header__container
		a.header__logo.header__logo--tantor(href='/')
			+icon('logo-tantor', 'header__logo-icon-tantor')
		.header__menu
			+mainMenu
		.header__last-group
			a.header__logo.header__logo--cnews(href='https://www.cnews.ru/', target='_blank')
				+icon('logo-cnews', 'header__logo-icon-cnews')
			.header__burger.burger(data-type='header')
				.burger__button
					.burger__line
