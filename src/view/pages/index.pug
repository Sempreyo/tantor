							.server__widget.server__widget--2.widget
								+button('Аналитика', 'button--black widget__link', '#', 'arrow-link')
								pre.widget__code
							.server__widget.server__widget--3.widget.widget--small
								.widget__stats
									.widget__stats-item
										p Выручка
										p ₽1.24 млн
										p ↑ 8.3%
									.widget__stats-item
										p Транзакции
										p 4 218
										p ↑ 12%
									.widget__stats-item
										p Средний чек
										p ₽294
										p ↑ 2.1%
								.widget__bars
									.widget__bar
										span Пн
										span.widget__bar-progress
											span(style='--percent: 55%')
