										span <b><span>18</span> <br> версия</b>
						.about__chart.chart.chart--3
							.chart__top.chart-anim-3
								+icon('logo-chart', 'chart__logo')
								span Tantor Postgres 18 для 1С
							.chart__window
								.chart__legend Постоянный рост <br> объема функциональности для 1С
								img.chart__mobile-graph(src='./images/graph-line-mobile.png', alt='')
								.chart__graph
									.chart__osy
										span(data-value='50')
